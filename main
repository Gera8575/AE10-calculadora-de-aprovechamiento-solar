#include <stdio.h>
#ifdef _WIN32
    #include <windows.h>
    #define PAUSA_MS(ms) Sleep(ms)
#else
    #include <unistd.h>
    #define PAUSA_MS(ms) usleep((ms) * 1000)
#endif

void ascii_typewriter(const char *str, int delay_us) {
    while (*str != '\0') {
        if (*str == '\033') {
            while (*str != '\0') {
                putchar(*str);
                if (*str == 'm') { 
                    str++;
                    break;
                }
                str++;
            }
            fflush(stdout);
        } else {
            putchar(*str);
            fflush(stdout);
            usleep(delay_us);
            str++;
        }
    }
}

